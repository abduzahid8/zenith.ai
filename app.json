{
  "expo": {
    "name": "zenyth.ai",
    "slug": "zenyth-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zenyth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "6",
      "bundleIdentifier": "com.zenyth.ai",
      "usesAppleSignIn": true,
      "entitlements": {},
      "infoPlist": {
        "NSHealthShareUsageDescription": "Zenyth reads your daily Screen Time data to show weekly usage trends and help you track your digital wellness goals.",
        "NSHealthUpdateUsageDescription": "Zenyth records your hobby session activity to help you measure productivity progress alongside screen time data.",
        "NSFamilyControlsUsageDescription": "Zenyth uses Family Controls to help you set and manage app usage limits as part of your productivity plan.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.zenyth.ai",
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.READ_SMS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70b10f9a-86f1-4deb-8cb2-03ce69f235f2"
      }
    }
  }
}
