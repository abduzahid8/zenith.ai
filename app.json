{
  "expo": {
    "name": "Zenyth",
    "slug": "zenyth-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/logo-icon-v2.png",
    "scheme": "zenyth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "63",
      "bundleIdentifier": "com.zenyth.ai",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "itms-apps",
          "itms-appss"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logo-icon-v2.png",
        "backgroundColor": "#000000"
      },
      "package": "com.zenyth.ai",
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.READ_SMS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-iap",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70b10f9a-86f1-4deb-8cb2-03ce69f235f2"
      }
    }
  }
}
