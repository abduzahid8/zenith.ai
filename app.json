{
    "expo": {
        "name": "zenyth.ai",
        "slug": "zenyth-ai",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "zenyth",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.zenyth.ai",
            "usesAppleSignIn": true,
            "infoPlist": {
                "NSHealthShareUsageDescription": "We need access to track your screen time",
                "NSHealthUpdateUsageDescription": "We use this to help you manage your screen time"
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "package": "com.zenyth.ai"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-font",
            "expo-apple-authentication"
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}