# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Web App URL (used as redirectTo in password reset emails so the link works in browsers)
# Set this to your deployed web app URL, e.g. https://your-app.vercel.app
# Without this, password reset links use the zenyth:// deep link which only works on mobile devices.
EXPO_PUBLIC_WEB_APP_URL=https://your-app.vercel.app

# AI Configuration
# Option 1: Server-side (secure) - Set as Supabase secret:
#   supabase secrets set GEMINI_API_KEY=your_gemini_api_key
#   Then set USE_LOCAL_AI = false in src/services/ai.ts
#
# Option 2: Client-side (less secure, API key exposed in bundle):
#   Use this for development/testing when edge functions have issues.
# ⚠️ WARNING: Anyone can extract this key from the app bundle!
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# E2E / manual QA without login (DEV BUILDS ONLY — unreachable in production)
# When set to 1 in a dev bundle (`npx expo start`), the app signs in a local
# mock user and seeds demo tasks from the real task engine. No credentials,
# no network, nothing is written to Supabase. Leave at 0 otherwise.
EXPO_PUBLIC_E2E_BYPASS_AUTH=0
