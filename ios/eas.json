{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "devclient": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false,
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      }
    },
    "devclient-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release",
        "simulator": true,
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      }
    }
  },
  "submit": {
    "submit-devclient": {
      "ios": {
        "ascAppId": null,
        "appleId": null,
        "appleTeamId": null,
        "companyName": null,
        "sku": "com.example.app.dev",
        "language": "en-US",
        "skuSuffix": "devclient",
        "track": "internal",
        "metadata": {
          "releaseNotes": "Internal Dev Client build"
        }
      }
    }
  }
}
